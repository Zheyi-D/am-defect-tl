# ---- 数据：绝不进 Git（0.9 GB 原图 + 预处理产物）----
/data/*
!/data/README.md

# ---- 模型权重 / 缓存 ----
*.pt
*.pth
*.ckpt
*.onnx
*.h5
*.npz
*.npy
# 例外：分类头 checkpoint 只有 ~130 KB，是复现 Grad-CAM / demo 的必要输入，要进 Git
!results/runs/**/model.pt

# ---- Python ----
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
venv/
env/

# ---- Notebook ----
.ipynb_checkpoints/

# ---- 压缩包 / 日志 ----
*.zip
*.tar.gz
*.log
wandb/

# ---- 系统 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 注意 ----
# results/runs/**/metrics.json 与 results/figures/** 要进 Git（体积小，是交付物），
# 不要在这里忽略它们。

# ---- Kaggle kernel 构建产物（base64 内嵌代码，生成物，不进 Git）----
kaggle/

# Gradio 本地证书
.gradio/

# 交接文档的 PDF 是生成物（源文件是 docs/HANDOVER.md）
docs/HANDOVER*.pdf

# runtime artefact of analysis/demo_client.py
results/client_inspection_log.csv

# testset/ : 657 张测试图片（约 170 MB），只有 README 进 Git
/testset/*
!/testset/README.md

# no-transfer ablation outputs (downloaded from Kaggle)
/results_ablation/
/kaggle_out*/

# temp images produced by tools/build_slides_pptx.py
reports/_slide_*.jpg

# deck build artefacts (regenerate with tools/build_slides_pptx.py)
/reports/_slide_cache/
/reports/preview*/
/reports/_build_tmp.pptx
reports/_slide_*.jpg

# Office lock files
reports/~$*
~$*.pptx

# keep the ablation summary table (the run dirs stay ignored)
!/results_ablation/ABLATION.md
